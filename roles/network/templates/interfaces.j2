#
# Only loopback remains here. `auto` or `allow-hotplug` on the NIC would have
# ifupdown — or udev's 80-ifupdown.rules — bring the link up and fight
# systemd-networkd for it, even with networking.service disabled.

auto lo
iface lo inet loopback
