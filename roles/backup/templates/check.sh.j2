#
# Verify the repository's integrity, reading a slice of the data (not only the
# index): a backup nobody checks is a backup nobody can restore.
set -euo pipefail

export RESTIC_PASSWORD_FILE="{{ backup_password_file }}"
restic -r "{{ backup_repo }}" check --read-data-subset=5%
