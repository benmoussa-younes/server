#!/bin/sh
# {{ ansible_managed }}
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# The login dashboard. pam_motd runs the scripts in /etc/update-motd.d/ and
# writes their output to /run/motd.dynamic, so this is shown on the console and
# over SSH alike. It is root-owned code executed at every interactive login:
# no network, no user input, and nothing written outside /run.
#
# Every command below exists on a Debian base. `LC_ALL=C` makes the parsing
# locale-independent; the labels come from `shell_motd_labels` and the decimal
# comma is printed literally, so the output does not depend on the caller.

LC_ALL=C
export LC_ALL

{% macro padded(text) %}{{ text }}{{ ' ' * (13 - (text | length)) }}{% endmacro %}

reset=""
dim=""
green=""
yellow=""
red=""
# pam_motd runs this through run-parts with a stripped environment: measured
# on the bench host (2026-10-22), the script saw only PATH and PWD, no TERM and no
# TTY. `NO_COLOR` cannot reach it, so the role variable is the only switch.
use_color="{{ shell_motd_color | lower }}"
if [ "$use_color" = "true" ]; then
	esc=$(printf '\033')
	dim="${esc}[2m"
	green="${esc}[1;32m"
	yellow="${esc}[1;33m"
	red="${esc}[1;31m"
	reset="${esc}[0m"
fi

# Labels are padded to 13 DISPLAY columns by the Jinja macro above: Jinja
# counts characters, while the rendered script runs under LC_ALL=C where
# `printf %-13s` and awk `length()` would count bytes.
line() {
	printf '  %s%s%s %s\n' "$dim" "$1" "$reset" "$2"
}

fmt_gio() {
	awk -v k="$1" 'BEGIN { printf "%.1f", k / 1048576 }' | tr '.' ','
}

fmt_size() {
	awk -v k="$1" 'BEGIN {
		if (k >= 1048576) printf "%.1f Gio", k / 1048576
		else printf "%.0f Mio", k / 1024
	}' | tr '.' ','
}

printf '%s%s %s%s\n' "$green" "{{ identity_name }}" "{{ identity_version }}" "$reset"
printf '%s\n' "────────────────────────────────────────────────────────────"

line "{{ padded(shell_motd_labels.host) }}" "$(uname -n)"

debian=$(cat /etc/debian_version 2>/dev/null || true)
# The system is the edition this product installs, so the row names it first and
# the Debian base second. The kernel string already carries the architecture
# (`...-amd64`): appending `$(uname -m)` said it twice.
line "{{ padded(shell_motd_labels.system) }}" "{{ identity_name }} {{ identity_version }} · Debian ${debian:-unknown} · noyau $(uname -r)"

read -r uptime_seconds _ < /proc/uptime
uptime_seconds=${uptime_seconds%%.*}
days=$((uptime_seconds / 86400))
hours=$(((uptime_seconds % 86400) / 3600))
minutes=$(((uptime_seconds % 3600) / 60))
if [ "$days" -gt 0 ]; then
	format_uptime=$(printf '%d j %02d h %02d min' "$days" "$hours" "$minutes")
else
	format_uptime=$(printf '%d h %02d min' "$hours" "$minutes")
fi
read -r load1 load5 load15 _ < /proc/loadavg
line "{{ padded(shell_motd_labels.uptime) }}" "${format_uptime} · {{ shell_motd_labels.load }} ${load1} ${load5} ${load15}"

mem_total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
mem_available=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
swap_total=$(awk '/^SwapTotal:/ { print $2 }' /proc/meminfo)
swap_free=$(awk '/^SwapFree:/ { print $2 }' /proc/meminfo)
mem_used=$((mem_total - mem_available))
mem_percent=$(awk -v u="$mem_used" -v t="$mem_total" 'BEGIN { printf "%d", (u * 100) / t }')
if [ "$swap_total" -gt 0 ]; then
	swap_used=$((swap_total - swap_free))
	swap_text="$(fmt_gio "$swap_used") Gio / $(fmt_gio "$swap_total") Gio"
else
	swap_text="{{ shell_motd_labels.no_swap }}"
fi
line "{{ padded(shell_motd_labels.memory) }}" "$(fmt_gio "$mem_used") Gio / $(fmt_gio "$mem_total") Gio (${mem_percent} %) · {{ shell_motd_labels.swap }} ${swap_text}"

for mount in{% for item in shell_motd_mounts %} {{ item | quote }}{% endfor %}; do
	[ -d "$mount" ] || continue
	df_line=$(df -P -k "$mount" 2>/dev/null | awk 'NR == 2 { print $3" "$2" "$5 }')
	[ -n "$df_line" ] || continue
	read -r used total percent <<EOF
$df_line
EOF
	percent=${percent%\%}
	if [ "$mount" = "/" ]; then
		label="{{ padded(shell_motd_labels.storage) }}"
	else
		label="{{ ' ' * 13 }}"
	fi
	line "$label" "${mount} : $(fmt_size "$used") / $(fmt_size "$total") (${percent} % {{ shell_motd_labels.used }})"
done

gateway=$(ip route show default 2>/dev/null | awk '/^default/ { print $3; exit }')
network_lines=$(ip -o -4 addr show scope global 2>/dev/null |
	awk -v gw="$gateway" '$3 == "inet" {
		n++
		s = $2" "$4
		if (n == 1 && gw != "")
			s = s" · {{ shell_motd_labels.gateway }} " gw
		print s
	}')
if [ -n "$network_lines" ]; then
	first=1
	while IFS= read -r entry; do
		if [ "$first" -eq 1 ]; then
			line "{{ padded(shell_motd_labels.network) }}" "$entry"
			first=0
		else
			line "{{ ' ' * 13 }}" "$entry"
		fi
	done <<EOF
$network_lines
EOF
else
	line "{{ padded(shell_motd_labels.network) }}" "{{ shell_motd_labels.no_global_address }}"
fi

apt_output=$(apt-get -s -o Debug::NoLocking=1 -o APT::Get::List-Cleanup=0 upgrade 2>/dev/null || true)
updates=$(printf '%s\n' "$apt_output" | grep -c '^Inst ' || true)
security=$(printf '%s\n' "$apt_output" | grep '^Inst ' | grep -ci 'security' || true)
if [ "$updates" -eq 0 ]; then
	update_text="${green}{{ shell_motd_labels.no_updates }}${reset}"
elif [ "$security" -gt 0 ]; then
	update_text="${yellow}${updates} {{ shell_motd_labels.updates_pending }}, {{ shell_motd_labels.updates_security }} ${security} {{ shell_motd_labels.updates_security_suffix }}${reset}"
else
	update_text="${yellow}${updates} {{ shell_motd_labels.updates_pending }}${reset}"
fi
if [ -e /run/reboot-required ] || [ -e /var/run/reboot-required ]; then
	update_text="${update_text} · ${red}{{ shell_motd_labels.reboot_required }}${reset}"
else
	update_text="${update_text} · {{ shell_motd_labels.reboot_not_required }}"
fi
line "{{ padded(shell_motd_labels.updates) }}" "$update_text"

failed=$(systemctl show -p NFailedUnits --value 2>/dev/null || true)
case "$failed" in
'' | *[!0-9]*) failed=0 ;;
esac
if [ "$failed" -eq 0 ]; then
	unit_text="${green}{{ shell_motd_labels.no_failed_units }}${reset}"
else
	names=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{ print $1 }' | paste -sd ', ' -)
	unit_text="${red}${failed} {{ shell_motd_labels.failed_units }}${reset}"
	[ -z "$names" ] || unit_text="${unit_text} : ${names}"
fi
line "{{ padded(shell_motd_labels.units) }}" "$unit_text"

printf '\n'
