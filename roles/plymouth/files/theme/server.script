# Server Edition boot splash.
#
# A server boots with no owner in front of the screen, so this theme says what
# the machine is and what it is doing -- the product mark, its name, and the
# boot, shutdown, reboot, fsck and password messages the initramfs raises. No
# animation: a logo that turns for nobody costs a refresh callback per frame.
#
# Plymouth's script plugin has two rules this file depends on: a sprite held
# only by a local is collected and disappears from the screen (every visible
# sprite is kept in a global), and a name without `local.` inside a function is
# the global of that name.

Window.SetBackgroundTopColor(0.008, 0.051, 0.035);     # #020d09
Window.SetBackgroundBottomColor(0.004, 0.012, 0.008);

logo = Image("logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX((Window.GetWidth() - logo.GetWidth()) / 2);
logo_sprite.SetY(Window.GetHeight() * 0.34 - logo.GetHeight() / 2);
logo_sprite.SetZ(-100);

text_colour.red = 0.850;
text_colour.green = 0.890;
text_colour.blue = 0.930;

action_colour.red = 0.196;
action_colour.green = 0.827;
action_colour.blue = 0.600;

fun place_text (text, colour, y) {
    local.image = Image.Text(text, colour.red, colour.green, colour.blue);
    local.sprite = Sprite(local.image);
    local.sprite.SetX((Window.GetWidth() - local.image.GetWidth()) / 2);
    local.sprite.SetY(y);
    local.sprite.SetZ(100);
    return local.sprite;
}

title_sprite = place_text("Server Edition", text_colour, Window.GetHeight() * 0.55);

status_sprite = NULL;
password_sprite = NULL;

fun show_status (text) {
    global.status_sprite = place_text(text, action_colour, Window.GetHeight() * 0.82);
}

mode = Plymouth.GetMode();
if (mode == "boot") {
    show_status("Démarrage en cours...");
} else if (mode == "shutdown") {
    show_status("Arrêt en cours...");
} else if (mode == "reboot") {
    show_status("Redémarrage en cours...");
}

# fsck progress and any other message the boot raises replace the status line.
fun message_callback (text) {
    if (!text) return;
    if (text == "") return;
    show_status(text);
}

Plymouth.SetMessageFunction(message_callback);

# An encrypted root asks here when `splash` is on the command line: dropping
# this callback would leave the boot waiting on a prompt nobody can see.
fun display_password_callback (prompt, bullets) {
    show_status(prompt);
    local.dots = "";
    local.index = 0;
    while (local.index < bullets) {
        local.dots += "*";
        local.index++;
    }
    global.password_sprite = place_text(local.dots, text_colour, Window.GetHeight() * 0.88);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
    global.password_sprite = NULL;
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun quit_callback () {
}

Plymouth.SetQuitFunction(quit_callback);

# The plugin redraws only from this callback.
fun refresh_callback () {
}

Plymouth.SetRefreshFunction(refresh_callback);
